rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Study Planner and Setpoint (unchanged)
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Model Router: each signed-in user can only reach their own settings and API keys
    match /modelRouter/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
