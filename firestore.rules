rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Invite-only: only these Google accounts may use Model Router.
    // To add or remove someone, edit this list and republish the rules.
    function invited() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'hebaghoneim8@gmail.com',
          'seifeldingamal2021@gmail.com'
        ];
    }

    // Each invited user can only reach their own keys, settings, chats and usage.
    match /modelRouter/{uid}/{doc=**} {
      allow read, write: if invited() && request.auth.uid == uid;
    }
  }
}
